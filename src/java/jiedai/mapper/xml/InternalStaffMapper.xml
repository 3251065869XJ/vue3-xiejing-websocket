<!-- InternalStaffMapper.xml -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.visitor.mapper.InternalStaffMapper">
    <select id="findByEmployeeId" resultType="com.example.visitor.entity.InternalStaff">
        SELECT id, employee_id, name, department
        FROM internal_staff
        WHERE employee_id = #{employeeId}
    </select>
</mapper>